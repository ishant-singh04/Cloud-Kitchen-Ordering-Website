# Application Environment Variables
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Database Connection
# You can use MongoDB Atlas URI, or local mongodb connection string.
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/cloudkitchen?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/cloudkitchen_pro

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_cloudkitchen_pro_2025_secure_token

# Razorpay Test Mode Credentials
# Get test keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_mock_cloudkitchen123
RAZORPAY_KEY_SECRET=secret_test_mock_cloudkitchen456
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_mock_cloudkitchen123

# Cloudinary (Optional - For production image storage)
CLOUDINARY_CLOUD_NAME=demo
CLOUDINARY_API_KEY=1234567890
CLOUDINARY_API_SECRET=abcdefghijklmnopqrstuvwxyz

# Supabase Configuration (Database & Store Assets Storage)
# Obtain from https://app.supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=cloudkitchen-assets
